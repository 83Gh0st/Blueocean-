# ---------------------------------------------------------------------------
# Blue Ocean Chemicals — environment variables
# Copy this file to .env.local for local development, and add the same
# values under Vercel → Project → Settings → Environment Variables for
# staging/production deployments.
# ---------------------------------------------------------------------------

# Shared password gate for the /internal staff portal (accounting, and any
# future internal tools). Choose a long, random passphrase — this is the
# only thing standing between the public and your internal tools.
INTERNAL_APP_PASSWORD=change-this-to-a-long-random-passphrase

# Secret used to sign the internal-portal session cookie (HMAC). Generate one
# with: `openssl rand -hex 32`
INTERNAL_SESSION_SECRET=change-this-to-a-64-character-random-hex-string

# ---------------------------------------------------------------------------
# Nothing else is required for the site or the internal portal shell today.
# When you build out a real internal tool (accounting, ERP, inventory...),
# add whatever environment variables it needs here — e.g. a DATABASE_URL
# for a Postgres instance from Neon (https://neon.tech) or Vercel Postgres.
# ---------------------------------------------------------------------------
